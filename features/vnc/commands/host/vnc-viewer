# `enclave vnc-viewer [container-or-session-name]`
#
# Opens a host-installed VNC viewer on the contained display of a session
# running with this feature. Runs on the host, outside the sandbox, because
# driving a host GUI is exactly what a session cannot do.
#
# It resolves the published RFB port from `enclave ps --json`, reads the
# per-session password out of the container through the engine's non-TTY exec
# (`enclave exec` always allocates a TTY), and hands the password to the viewer
# through the environment rather than argv, which /proc would expose to every
# local user for the viewer's lifetime.

set -euo pipefail

readonly RFB_CONTAINER_PORT=5900
readonly PASSWORD_PATH=/tmp/enclave-vnc/vnc-password
readonly READY_TIMEOUT=20
readonly POLL_INTERVAL=0.5

enclave_bin=${ENCLAVE_BIN:-enclave}
# How to spell enclave back at the user: ENCLAVE_BIN is an absolute path.
enclave_verb=$(basename "$enclave_bin")

die() {
	printf 'vnc-viewer: %s\n' "$*" >&2
	exit 1
}

info() {
	printf 'vnc-viewer: %s\n' "$*" >&2
}

usage() {
	cat <<'EOF'
Usage: enclave vnc-viewer [container-or-session-name]

Open a host-installed VNC viewer on the contained display of a session started
with the vnc feature (enclave --features +vnc).

The argument is a container name from `enclave ps` or a session name passed to
--name. Without it, the current project's only VNC-enabled container is used;
if several are running, their names are listed and one must be passed.

The viewer defaults to xtigervncviewer (macOS: the built-in Screen Sharing via
open) and is replaced with the vnc_viewer key in enclave's config.json:

  {"vnc_viewer": ["remmina", "-c", "vnc://:{password}@{host}:{port}"]}

Placeholders {host}, {port}, {password} and {container} are substituted. A
command referencing neither {host} nor {port} gets <host>:<port> appended. The
session password is also exported as VNC_PASSWORD and ENCLAVE_VNC_PASSWORD.
EOF
}

requested=""
while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	-*)
		die "unknown flag $1 (try --help)"
		;;
	*)
		[ -z "$requested" ] || die "expected at most one container or session name"
		requested=$1
		;;
	esac
	shift
done

command -v jq >/dev/null 2>&1 ||
	die "jq is required (Debian/Ubuntu: apt install jq, macOS: brew install jq)"

config_json=$("$enclave_bin" config --json) || die "cannot read the enclave config"
global_config=$(printf '%s' "$config_json" | jq -r '.paths.global // empty')
project_config=$(printf '%s' "$config_json" | jq -r '.paths.project // empty')
[ -n "$project_config" ] || die "cannot resolve the current project"
project_hash=$(basename "$(dirname "$project_config")")

sessions_json=$("$enclave_bin" ps --json) || die "cannot list enclave containers"

# One tab-separated row per published RFB binding: name, session name, project
# hash, host IP, host port. A session without this feature publishes no such
# binding, which is what separates "no session" from "session without a
# display" in the errors below.
rows=$(printf '%s' "$sessions_json" | jq -r --arg port "$RFB_CONTAINER_PORT" '
	.[]
	| . as $session
	| select(($session.name // "") != "")
	| $session.ports[]?
	| select(.containerPort == $port and (.hostPort // "") != "")
	| select((.protocol // "") as $proto | $proto == "" or $proto == "tcp")
	| [$session.name, ($session.sessionName // ""), ($session.projectHash // ""), (.hostIP // ""), .hostPort]
	| @tsv
' | sort)

# Rows matching field $1 against value $2, tab-separated.
select_rows() {
	printf '%s\n' "$rows" | awk -F '\t' -v field="$1" -v value="$2" 'NF > 0 && $field == value'
}

count_rows() {
	if [ -z "$1" ]; then
		printf '0'
	else
		printf '%s\n' "$1" | wc -l | tr -d ' '
	fi
}

names_of() {
	printf '%s\n' "$1" | cut -f 1 | sed 's/^/  /'
}

if [ -n "$requested" ]; then
	# A container name is unique across projects and resolves verbatim, as it
	# does in attach, stop, and theia. A session name is matched afterwards,
	# preferring this project's sessions.
	matched=$(select_rows 1 "$requested")
	if [ -z "$matched" ]; then
		matched=$(select_rows 2 "$requested" | awk -F '\t' -v hash="$project_hash" '$3 == hash')
	fi
	if [ -z "$matched" ]; then
		matched=$(select_rows 2 "$requested")
	fi
	case "$(count_rows "$matched")" in
	0)
		die "no running enclave container named \"$requested\" with a VNC display (\`$enclave_verb ps\` lists the running ones)"
		;;
	1) ;;
	*)
		die "several containers match \"$requested\". Pass a container name explicitly:
$(names_of "$matched")"
		;;
	esac
else
	matched=$(printf '%s\n' "$rows" | awk -F '\t' -v hash="$project_hash" 'NF > 0 && $3 == hash')
	case "$(count_rows "$matched")" in
	0)
		other=$(printf '%s' "$sessions_json" | jq -r --arg hash "$project_hash" '
			.[] | select((.projectHash // "") == $hash) | .name' | sort | tr '\n' ' ')
		if [ -n "${other// /}" ]; then
			die "no running enclave container for this project has a VNC display. Restart with \`$enclave_verb --features +vnc\` (running: ${other% })"
		fi
		die "no running enclave container for this project (start one with \`$enclave_verb --features +vnc\`)"
		;;
	1) ;;
	*)
		die "multiple running enclave containers with a VNC display. Pass a container or session name explicitly:
$(names_of "$matched")"
		;;
	esac
fi

container=$(printf '%s' "$matched" | cut -f 1)
host_ip=$(printf '%s' "$matched" | cut -f 4)
port=$(printf '%s' "$matched" | cut -f 5)

# The feature publishes on the host loopback. A wildcard binding still reaches
# the display through loopback, so prefer that over handing 0.0.0.0 to a viewer.
case "$host_ip" in
"" | "0.0.0.0" | "::" | "[::]") host=127.0.0.1 ;;
*) host=$host_ip ;;
esac

# `enclave exec` always allocates a TTY, which a password read cannot use, so
# the read goes through the engine that actually holds the container. Trying
# both covers docker, rootless podman, and the podman-docker shim without
# duplicating enclave's backend resolution here.
engine=""
for candidate in docker podman; do
	if command -v "$candidate" >/dev/null 2>&1 &&
		"$candidate" container inspect "$container" >/dev/null 2>&1; then
		engine=$candidate
		break
	fi
done
[ -n "$engine" ] || die "neither docker nor podman knows a container named \"$container\""

# The supervisor runs in the background, so `enclave vnc-viewer` right after
# `enclave run` can legitimately arrive before the password exists and before
# Xvnc listens. Wait for both.
probe_port() {
	(exec 3<>"/dev/tcp/$host/$port") >/dev/null 2>&1
}

password=""
last_error=""
notified=0
deadline=$(($(date +%s) + READY_TIMEOUT))
while :; do
	if out=$("$engine" exec "$container" cat "$PASSWORD_PATH" 2>&1); then
		candidate_password=$(printf '%s' "$out" | tr -d '[:space:]')
		if [ -z "$candidate_password" ]; then
			last_error="$PASSWORD_PATH is empty"
		elif probe_port; then
			password=$candidate_password
			break
		else
			last_error="cannot connect to $host:$port"
		fi
	else
		last_error="read $PASSWORD_PATH in $container: $out"
	fi

	if [ "$(date +%s)" -ge "$deadline" ]; then
		die "the VNC display of $container is not ready after ${READY_TIMEOUT}s: $last_error (check the supervisor logs in /tmp/enclave-vnc/log)"
	fi
	if [ "$notified" -eq 0 ]; then
		info "waiting for the VNC display of $container to come up"
		notified=1
	fi
	sleep "$POLL_INTERVAL"
done

# vnc_viewer is read straight out of enclave's own config files, global first
# and project on top, so the key layers the way every other config key does.
# enclave itself ignores it: the viewer is a host command, not a session option.
viewer=()
read_viewer() {
	[ -n "$1" ] && [ -f "$1" ] || return 0
	local kind
	kind=$(jq -r 'if has("vnc_viewer") then (.vnc_viewer | type) else "absent" end' "$1" 2>/dev/null) ||
		die "cannot parse $1"
	case "$kind" in
	absent | "null") return 0 ;;
	array) ;;
	*) die "vnc_viewer in $1 must be an array of strings, not $kind" ;;
	esac
	viewer=()
	while IFS= read -r arg; do
		viewer+=("$arg")
	done < <(jq -r '.vnc_viewer[] | tostring' "$1")
}
read_viewer "$global_config"
read_viewer "$project_config"

# macOS ships Screen Sharing, which handles vnc:// URLs including the password,
# so nothing needs installing there. Elsewhere the reference viewer is
# TigerVNC's, which takes the password from the environment.
if [ "${#viewer[@]}" -eq 0 ]; then
	if [ "$(uname -s)" = "Darwin" ]; then
		viewer=(open "vnc://:{password}@{host}:{port}")
	else
		viewer=(xtigervncviewer "{host}:{port}")
	fi
fi

# A command that references neither {host} nor {port} gets "<host>:<port>"
# appended, so a bare ["remmina"] or ["vncviewer"] works as configured.
argv=()
addressed=0
for arg in "${viewer[@]}"; do
	case "$arg" in
	*"{host}"* | *"{port}"*) addressed=1 ;;
	esac
	arg=${arg//\{host\}/$host}
	arg=${arg//\{port\}/$port}
	arg=${arg//\{password\}/$password}
	arg=${arg//\{container\}/$container}
	argv+=("$arg")
done
[ "$addressed" -eq 1 ] || argv+=("$host:$port")

if ! command -v "${argv[0]}" >/dev/null 2>&1; then
	config_hint=${global_config:-the enclave config.json}
	die "viewer \"${argv[0]}\" not found on PATH.
Install one (Debian/Ubuntu: apt install tigervnc-viewer, macOS: built in) or configure
another as vnc_viewer in $config_hint, e.g.
  {\"vnc_viewer\": [\"remmina\", \"-c\", \"vnc://:{password}@{host}:{port}\"]}"
fi

info "opening $container display at $host:$port with ${argv[0]}"

# The password reaches the viewer through the environment only: never in argv,
# where /proc would expose it to every local user for the viewer's lifetime.
# {password} opts out of that deliberately, for viewers that take it no other way.
export VNC_PASSWORD="$password"
export ENCLAVE_VNC_PASSWORD="$password"
exec "${argv[@]}"
